# ============================================================
#  WIA VENDING - 환경 설정
#  이 파일을 ".env" 로 복사한 뒤 값을 채우세요.
# ============================================================

# ---------- 디스코드 ----------
DISCORD_TOKEN=여기에_봇_토큰
# 봇 소유자(오너) 디스코드 유저 ID. 콤마로 여러 명 지정 가능.
# 오너만 /라이센스 발급, 오너 전용 웹 기능을 사용할 수 있습니다.
OWNER_IDS=123456789012345678
# 슬래시 명령어를 즉시 동기화할 서버 ID (개발 중 권장, 비우면 전역 동기화)
GUILD_ID=

# ---------- 웹 패널 ----------
WEB_HOST=0.0.0.0
WEB_PORT=8080
# 외부에서 접속할 주소. HTTPS 도메인을 넣으세요. (예: https://panel.example.com)
PUBLIC_BASE_URL=http://localhost:8080
# HTTPS 운영 시 true
COOKIE_SECURE=false
# 웹 로그인 세션 유지 일수
SESSION_DAYS=7
# /웹패널 1회용 링크 유효 시간(분)
LOGIN_TOKEN_MINUTES=15

# ---------- 자동 충전 (Pushbullet) ----------
# https://www.pushbullet.com/#settings/account 에서 Create Access Token
PUSHBULLET_TOKEN=
# 알림을 받을 앱 패키지 제한 (비우면 입금 키워드로만 판별)
# 예: com.kbstar.kbbank,com.shinhan.sbanking,com.google.android.apps.messaging
PUSHBULLET_ALLOWED_PACKAGES=
# 무시할 앱 패키지 (기본: Pushbullet 자체 알림 등)
PUSHBULLET_BLOCKED_PACKAGES=com.pushbullet.android,com.android.systemui
# REST 폴링 주기(초). 웹소켓이 끊겨도 이 주기로 새 알림을 확인합니다.
PUSHBULLET_POLL_SECONDS=60
# 자동 충전 마스터 스위치 (false 면 입금 알림을 검토 대기로만 저장)
AUTO_CHARGE_ENABLED=true
# 입금 요청 만료 시간(시간)
DEPOSIT_TTL_HOURS=6

# ---------- 입금 계좌 안내 ----------
BANK_NAME=KB국민은행
BANK_ACCOUNT=123456-78-901234
BANK_HOLDER=홍길동

# ---------- 브랜드 ----------
BRAND_NAME=WIA VENDING
# 문의 버튼 URL (비우면 "관리자에게 DM" 안내)
SUPPORT_URL=
# 패널 상단 배너 이미지 URL (비우면 기본 배너 사용)
BANNER_URL=
# 서버 등록 시 라이센스 필수 여부
LICENSE_ENFORCE=true
LOG_LEVEL=INFO
